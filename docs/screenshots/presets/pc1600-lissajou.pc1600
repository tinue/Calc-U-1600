# User-guide screenshots: the CE-1600P has just plotted the Lissajous demo
# (examples/plotter/lissajou-1600.bas).
model: PC-1600
plotter: ce1600p
keys:
  - key: mode
  - type: NEW0
program:
  path: ../../../examples/plotter/lissajou-1600.bas
  format: basic-binary
keys:
  - key: mode
  - type: RUN
  - wait:
