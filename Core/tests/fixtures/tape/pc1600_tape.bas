10 REM CASSETTE ROUND TRIP FIXTURE - PC-1600
20 DIM A(20),B$(5)*16
30 FOR I=1 TO 20:A(I)=I*I-3*I+7:NEXT I
40 B$(1)="CLOAD":B$(2)="CSAVE":B$(3)="MERGE":B$(4)="CHAIN"
50 S=0:FOR I=1 TO 20:S=S+A(I):NEXT I
60 PRINT "SUM=";S;" MEAN=";S/20
70 FOR J=1 TO 4:PRINT J;":";B$(J):NEXT J
80 IF S<>2310 THEN PRINT "BAD SUM":END
90 PRINT USING "####.##";S/7
100 X=SIN(30)+COS(60)+TAN(45):PRINT "TRIG=";X
110 GOSUB 500:PRINT "BACK"
