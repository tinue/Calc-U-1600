C5E5: 007FC703          
C5E9: C8                
C5EA: 04040140                  db 4, 0x04, 1, 0x40,0x00, lo(lbl_d_p1b4),hi(lbl_d_p1b4),   lo(fn_p1b4),hi(fn_p1b4)
C5EE: 0094C715          
