C3B7: 5D       [259]            ld   e, l
C3B8: AF       [263]            xor  a
C3B9: CDEB00   [280]            call PRTASTR
                        
C3BC: D1       [290]            pop  de                        ; recover the checksum computed above
C3BD: 217DCB   [300]            ld   hl, status_buf
C3C0: 364323   [316]            ld   (hl), 'C' \ inc hl
C3C3: 364823   [332]            ld   (hl), 'H' \ inc hl
C3C6: 364B23   [348]            ld   (hl), 'K' \ inc hl
C3C9: 363D23   [364]            ld   (hl), '=' \ inc hl
C3CC: 7A       [368]            ld   a, d
C3CD: CD59C5   [385]            call hex_byte
C3D0: 7B       [389]            ld   a, e
