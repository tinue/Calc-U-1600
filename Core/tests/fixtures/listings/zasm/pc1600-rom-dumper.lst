                        ; --------------------------------------
                        ; zasm: assemble "pc1600-rom-dumper.asm"
                        ; date: 2026-10-07 09:15:51
                        ; --------------------------------------


                        ; ============================================================================
                        ; PC-1600 ROM Bank Dumper
                        ;
                        ; Menu-driven Z-80 ML program for the Sharp PC-1600:
                        ;
                        ;   1 = SWEEP -- pages every Z-80-addressable bank of pages 1 and 2 into the
                        ;       CPU's address space in turn and shows two short hex samples on the
                        ;       LCD (4000H/6000H or 8000H/A000H, where module headers sit), pausing
                        ;       for a keypress between screens. Diagnostic tool: confirms which
                        ;       banks hold real ROM vs. open bus, and lets you eyeball a bank's
                        ;       content before committing to a full dump.
                        ;
                        ;   2 = DUMP+SEND -- pages in the 7 banks confirmed to hold real ROM content
                        ;       (see dump_table below), shows a 16-bit checksum per page, and on a
                        ;       keypress sends the full 16KB page out over COM1: via the serial
                        ;       IOCS (CSNDA). Press S to skip a page instead of sending it. COM1:
                        ;       itself must already be configured (SETCOM/OUTSTAT/SNDSTAT/RCVSTAT/
                        ;       INIT) from BASIC before this program is CALLed -- see
                        ;       DUMPING.md for the exact sequence. This
                        ;       program only calls CSNDA; it never touches CWCOM/CESND/CCLRSB.
                        ;
                        ;   4 = OTHER BANKS -- same UX as DUMP+SEND for every other bank that
                        ;       could hold a peripheral ROM: page 1 banks 1, 2, 6, 7 (the 60-pin
                        ;       bus banks the reset scan SCANMODS probes, besides the CE-1600P's
                        ;       4/5 and the internal 0/3), page 2 banks 0-3 (memory slots, e.g. a
                        ;       CE-1620M ROM cartridge; vertical bank 0 only, Port 28H untouched),
                        ;       bank 4 plain and with Port 3DH = 02H (the JAPAN/kanji ROM view the
                        ;       firmware's SELJROM selects), 5 and 7. Pages that read all FFH say
                        ;       so on the send prompt, so empty banks are easy to skip.
                        ;
                        ;   3 = LH5803 ROM -- dumps the LH-5803 co-processor's own private 16KB ROM
                        ;       (LH-5803 view C000H-FFFFH), which no Z-80 bank-switching combination
                        ;       can reach -- it's the *other* half of the same physical chip as
                        ;       Bank 6/CS123, addressed only from the LH-5803's own side. Reached
                        ;       via the CALLH bridge (CALL 01C6H): a 2-byte LH-5801 stub (`lda (x)`
                        ;       / `rtn`) placed in the shared 4000-7FFF/C000-FFFF RAM fetches one
                        ;       byte per round-trip, using X as the source pointer and A/PARA as
                        ;       the return path. Same checksum-then-keypress-then-send UX as
                        ;       DUMP+SEND, but as a single fixed 16KB region rather than 7 banks.
                        ;
                        ; Runs entirely from C000-FFFF (page 3, bank 0 -- never touched by this
                        ; program) so paging banks into 4000-7FFF/8000-BFFF never disturbs the code
                        ; that is doing the paging. Page 3 bank 1 (Port 31H b7) and the Slot 2
                        ; remap into pages 0/1 (Port 3CH) are therefore out of reach, and hold no
                        ; known ROM anyway. All display/IOCS calls used here live in the
                        ; always-resident bank 0 (0000-3FFF), so they too are unaffected.
                        ;
                        ; Assumes the machine is already NEW'd with enough S0: space to hold this
                        ; program; DUMPING.md gives the load sequence.
                        ;
                        ; Hardware note -- Port 3DH (hidden-BASIC-ROM sub-bank select, bit b2):
                        ; clearing b2 selects Bank 3b instead of Bank 3 at 4000-7FFF. This port is
                        ; write-only. Getting a correct read of Bank 3/3b requires two things this
                        ; program does everywhere it touches the port:
                        ; write-only; the firmware keeps its current value in RAM at F07DH. The
                        ; IM2 interrupt entry (082CH) and every RST 18H / BANKCALL bank switch
                        ; (which all the IOCS calls used here go through) force Port 3DH to 04H
                        ; while they run and then restore it *from F07DH*. So SET_PORT3D writes
                        ; F07DH and the port together, as the ROM itself does; the selection then
                        ; survives interrupts and IOCS calls. A bare OUT (3DH) would be undone by
                        ; the next interrupt (F07DH still says 04H) -- the cause of the early
                        ; "Bank 3b reads identical to Bank 3" results.
                        ; ============================================================================
                        
                        #target bin
                        
                        ; ---- IOCS entry points (TRM, all in Bank 0 / always resident) ----
0190:                   BANKSET     equ 0x0190      ; A=bank, B=page(0-3) -> set bank
0193:                   BANKREAD    equ 0x0193      ; B=page -> A=current bank
018D:                   MEMORYCHK   equ 0x018D      ; D=bank, E=addr high byte -> CF=1/A=00 none, CF=0/A=01 RAM, CF=0/A=03 ROM
0112:                   CLS         equ 0x0112
0115:                   CRSRSET     equ 0x0115      ; D=X(0-25), E=Y(0-3)
00EB:                   PRTASTR     equ 0x00EB      ; DE=addr, A=terminator byte -> prints until terminator
0166:                   KEYGET      equ 0x0166      ; waits for a key; CF=0 -> A=key code
                        
                        ; ---- Serial IOCS gateway (PC-1600-Serial-Commands.md Part 2) ----
01D8:                   SERIAL      equ 0x01D8      ; C=routine#, D=channel(1=COM1:) as needed -> dispatch
0003:                   S_CSNDA     equ 0x03        ; A=byte to send -> CF=1/A=error byte on failure
                        
003D:                   PORT3D      equ 0x3D        ; hidden-BASIC-ROM sub-bank select (bit 2; not readable via IN)
F07D:                   PORT3D_M    equ 0xF07D      ; firmware's copy of Port 3DH; interrupts/bank calls restore from it
                        
                        ; ---- Z-80 -> LH-5803 bridge (PC-1600-CPU-LH5803-Compat.md Part 3) ----
01C6:                   CALLH       equ 0x01C6      ; hands off to an LH-5803 subroutine, returns when it RTNs
F002:                   CMDZ        equ 0xF002      ; 20H = no params in, 30H = load PARA..PARUH before entry
F005:                   PARA        equ 0xF005      ; -> LH-5803 A on entry; <- LH-5803 A on return
F006:                   PARXL       equ 0xF006      ; -> LH-5803 XL (low byte of the X reg pair)
F007:                   PARXH       equ 0xF007      ; -> LH-5803 XH (high byte)
F00C:                   PARPCL      equ 0xF00C      ; subroutine entry address, low byte (LH-5803-view)
F00D:                   PARPCH      equ 0xF00D      ; subroutine entry address, high byte
F00E:                   PARBAN      equ 0xF00E      ; subroutine bank: 00H = PV(0), 01H = PV(1)
                        
C0C5:                   #code CODE, 0xC0C5
                        
                        ; ============================================================================
                        ; Entry point: menu -- 1 = sweep, 2 = dump+send, 3 = LH5803 ROM,
                        ; 4 = other banks.
C0C5:                   start:
C0C5: CD1201   [17]             call CLS
C0C8: 2173C6   [27]             ld   hl, lbl_menu1
C0CB: CDA4C4   [44]             call show_label
C0CE: 1600     [51]             ld   d, 0
C0D0: 1E01     [58]             ld   e, 1
C0D2: CD1501   [75]             call CRSRSET
C0D5: 2185C6   [85]             ld   hl, lbl_menu2
C0D8: 54       [89]             ld   d, h
C0D9: 5D       [93]             ld   e, l
C0DA: AF       [97]             xor  a
C0DB: CDEB00   [114]            call PRTASTR
                        
C0DE: 1600     [121]            ld   d, 0
C0E0: 1E02     [128]            ld   e, 2
C0E2: CD1501   [145]            call CRSRSET
C0E5: 219AC6   [155]            ld   hl, lbl_menu3
C0E8: 54       [159]            ld   d, h
C0E9: 5D       [163]            ld   e, l
C0EA: AF       [167]            xor  a
C0EB: CDEB00   [184]            call PRTASTR
                        
C0EE: 1600     [191]            ld   d, 0
C0F0: 1E03     [198]            ld   e, 3
C0F2: CD1501   [215]            call CRSRSET
C0F5: 21A7C6   [225]            ld   hl, lbl_menu4
C0F8: 54       [229]            ld   d, h
C0F9: 5D       [233]            ld   e, l
C0FA: AF       [237]            xor  a
C0FB: CDEB00   [254]            call PRTASTR
                        
C0FE:                   menu_wait:
C0FE: CD6601   [17]             call KEYGET
C101: FE31     [24]             cp   '1'
C103: CA17C1   [34|34]          jp   z, sweep_start
C106: FE32     [41]             cp   '2'
C108: CA91C1   [51|51]          jp   z, dump_start
C10B: FE33     [58]             cp   '3'
C10D: CA81C3   [68|68]          jp   z, lh5803_dump_start
C110: FE34     [75]             cp   '4'
C112: CA97C1   [85|85]          jp   z, other_dump_start
C115: 18E7     [97]             jr   menu_wait
                        
                        ; ============================================================================
                        ; Sweep: walk every known bank, page 0/1/2, showing a hex sample on the LCD.
C117:                   sweep_start:
C117: CD1201   [17]             call CLS
                        
                                ; ---- Page 0 sample: bank 0 is always resident, no BANKSET needed ----
C11A: 2125CA   [27]             ld   hl, lbl_page0
C11D: CDA4C4   [44]             call show_label
C120: 3E00     [51]             ld   a, 0                  ; "bank 0" for the BR=/CHK= line (informational only)
C122: 1600     [58]             ld   d, 0
C124: 1E00     [65]             ld   e, 0x00
C126: CDB4C4   [82]             call show_status           ; MEMORYCHK D=0,E=00 -- page-0 bank 0
C129: 210000   [92]             ld   hl, 0x0000
C12C: 1195CB   [102]            ld   de, line_buf
C12F: CD25C5   [119]            call BUILD_HEX_LINE
C132: 1600     [126]            ld   d, 0
C134: 1E02     [133]            ld   e, 2
C136: 2195CB   [143]            ld   hl, line_buf
C139: CD45C5   [160]            call DISPLAY_LINE_AT
C13C: CD6FC5   [177]            call wait_key
                        
                                ; ---- Page 1 sweep ----
C13F: DD2173C5 [191]            ld   ix, page1_table
C143:                   p1_loop:
C143: DD7E00   [19]             ld   a, (ix+0)
C146: FEFF     [26]             cp   0xFF
C148: CA5AC1   [36|36]          jp   z, p2_start
C14B: CD17C4   [53]             call run_page1_entry
C14E: DDE5     [68]             push ix
C150: E1       [78]             pop  hl
C151: 110500   [88]             ld   de, 5      ; page1_table record size: bank,port3d,mode,lbl_lo,lbl_hi
C154: 19       [99]             add  hl, de
C155: E5       [110]            push hl
C156: DDE1     [124]            pop  ix
C158: 18E9     [136]            jr   p1_loop
                        
                        ; ============================================================================
C15A:                   p2_start:
                                ; ---- Page 2 sweep ----
C15A: DD21A1C5 [14]             ld   ix, page2_table
C15E:                   p2_loop:
C15E: DD7E00   [19]             ld   a, (ix+0)
C161: FEFF     [26]             cp   0xFF
C163: CA75C1   [36|36]          jp   z, all_done
C166: CD58C4   [53]             call run_page2_entry
C169: DDE5     [68]             push ix
C16B: E1       [78]             pop  hl
C16C: 110400   [88]             ld   de, 4      ; page2_table record size: bank,port3d,lbl_lo,lbl_hi
C16F: 19       [99]             add  hl, de
C170: E5       [110]            push hl
C171: DDE1     [124]            pop  ix
C173: 18E9     [136]            jr   p2_loop
                        
                        ; ============================================================================
C175:                   all_done:
                                ; Restore known-good defaults before returning to BASIC:
                                ; page 1 -> bank 0, page 2 -> bank 6 (system ROM), hidden-BASIC off.
C175: AF       [ 4]             xor  a
C176: 0601     [11]             ld   b, 1
C178: CD9001   [28]             call BANKSET
C17B: 3E06     [35]             ld   a, 6
C17D: 0602     [42]             ld   b, 2
C17F: CD9001   [59]             call BANKSET
C182: 3E04     [66]             ld   a, 0x04
C184: CDA3C2   [83]             call SET_PORT3D
                        
C187: CD1201   [100]            call CLS
C18A: 2139CA   [110]            ld   hl, lbl_done
C18D: CDA4C4   [127]            call show_label
C190: C9       [137]            ret
                        
                        ; ============================================================================
                        ; Dump+send: page in each of the 7 confirmed-ROM banks in turn, show a
                        ; checksum, wait for a keypress (S = skip, anything else = send), then send
                        ; the full 16KB page over COM1:.
C191:                   dump_start:
C191: DD21C6C5 [14]             ld   ix, dump_table
C195: 1804     [26]             jr   dump_run
                        
                        ; Other banks: the same loop over other_table (menu option 4).
C197:                   other_dump_start:
C197: DD2106C6 [14]             ld   ix, other_table
C19B:                   dump_run:
C19B: CD1201   [17]             call CLS
C19E:                   dump_loop:
C19E: DD7E00   [19]             ld   a, (ix+0)
C1A1: FEFF     [26]             cp   0xFF
C1A3: CAEBC1   [36|36]          jp   z, dump_done
C1A6: CD07C2   [53]             call run_dump_entry
C1A9: 3006     [60|65]          jr   nc, dump_next
C1AB: 32C5CB   [73]             ld   (send_err_code), a     ; CSNDA reported an error -- save the error
C1AE: C3BDC1   [83]             jp   dump_error             ; byte before CLS/show_label clobber A
C1B1:                   dump_next:
C1B1: DDE5     [15]             push ix
C1B3: E1       [25]             pop  hl
C1B4: 110900   [35]             ld   de, 9      ; dump_table record size: bank,port3d,page,base_hi,
                                                 ; base_lo,lbl_lo,lbl_hi,fn_lo,fn_hi
C1B7: 19       [46]             add  hl, de
C1B8: E5       [57]             push hl
C1B9: DDE1     [71]             pop  ix
C1BB: 18E1     [83]             jr   dump_loop
                        
                        ; ============================================================================
C1BD:                   dump_error:
C1BD: CD1201   [17]             call CLS
C1C0: 21B5C6   [27]             ld   hl, lbl_error
C1C3: CDA4C4   [44]             call show_label
C1C6: 217DCB   [54]             ld   hl, status_buf
C1C9: 364523   [70]             ld   (hl), 'E' \ inc hl
C1CC: 365223   [86]             ld   (hl), 'R' \ inc hl
C1CF: 363D23   [102]            ld   (hl), '=' \ inc hl
C1D2: 3AC5CB   [115]            ld   a, (send_err_code)
C1D5: CD59C5   [132]            call hex_byte
C1D8: 3600     [142]            ld   (hl), 0
C1DA: 1600     [149]            ld   d, 0
C1DC: 1E01     [156]            ld   e, 1
C1DE: CD1501   [173]            call CRSRSET
C1E1: 217DCB   [183]            ld   hl, status_buf
C1E4: 54       [187]            ld   d, h
C1E5: 5D       [191]            ld   e, l
C1E6: AF       [195]            xor  a
C1E7: CDEB00   [212]            call PRTASTR
C1EA: C9       [222]            ret
                        
                        ; ============================================================================
C1EB:                   dump_done:
                                ; Restore known-good defaults before returning to BASIC, same as
                                ; Stage 1's all_done:.
C1EB: AF       [ 4]             xor  a
C1EC: 0601     [11]             ld   b, 1
C1EE: CD9001   [28]             call BANKSET
C1F1: 3E06     [35]             ld   a, 6
C1F3: 0602     [42]             ld   b, 2
C1F5: CD9001   [59]             call BANKSET
C1F8: 3E04     [66]             ld   a, 0x04
C1FA: CDA3C2   [83]             call SET_PORT3D
                        
C1FD: CD1201   [100]            call CLS
C200: 2139CA   [110]            ld   hl, lbl_done
C203: CDA4C4   [127]            call show_label
C206: C9       [137]            ret
                        
                        ; ============================================================================
                        ; run_dump_entry: (ix) = { bank, port3d, page, base_hi, base_lo, lbl_lo,
                        ;                           lbl_hi, fn_lo, fn_hi }
                        ;   port3d = 0xFF means "don't touch" (page 0/page 2 entries).
                        ;   page = 0 means "always resident, no BANKSET call" (the page-0 entry).
                        ; Returns: CF/A as SEND_PAGE (CF=1, A=error byte, on a CSNDA failure).
C207:                   run_dump_entry:
C207: DD7E02   [19]             ld   a, (ix+2)              ; page number
C20A: B7       [23]             or   a
C20B: 2808     [30|35]          jr   z, rde_no_bankset      ; page 0 -- always resident, nothing to switch
C20D: 4F       [34]             ld   c, a                   ; c = page number
C20E: DD7E00   [53]             ld   a, (ix+0)              ; a = bank number
C211: 41       [57]             ld   b, c                   ; b = page number
C212: CD9001   [74]             call BANKSET
C215:                   rde_no_bankset:
C215: DD7E01   [19]             ld   a, (ix+1)              ; port3d value, or 0xFF = don't touch
C218: FEFF     [26]             cp   0xFF
C21A: 2002     [33|38]          jr   nz, rde_have_port3d
C21C: 3E04     [40]             ld   a, 0x04                ; "don't touch" -> the safe/normal default
C21E:                   rde_have_port3d:
C21E: CDA3C2   [17]             call SET_PORT3D
                        
                                ; checksum over the 16KB page, base address = (ix+3):(ix+4)
C221: DD6E04   [36]             ld   l, (ix+4)
C224: DD6603   [55]             ld   h, (ix+3)
C227: CDA9C2   [72]             call COMPUTE_CHECKSUM       ; HL preserved, DE = checksum, (page_and)
C22A: D5       [83]             push de                     ; stash across the display calls below
                        
C22B: CD1201   [100]            call CLS
C22E: DD6E05   [119]            ld   l, (ix+5)
C231: DD6606   [138]            ld   h, (ix+6)
C234: CDA4C4   [155]            call show_label
                        
                                ; filename hint on line 1
C237: 1600     [162]            ld   d, 0
C239: 1E01     [169]            ld   e, 1
C23B: CD1501   [186]            call CRSRSET
C23E: DD6E07   [205]            ld   l, (ix+7)
C241: DD6608   [224]            ld   h, (ix+8)
C244: 54       [228]            ld   d, h
C245: 5D       [232]            ld   e, l
C246: AF       [236]            xor  a
C247: CDEB00   [253]            call PRTASTR
                        
C24A: D1       [263]            pop  de                     ; recover the checksum computed above
C24B: 217DCB   [273]            ld   hl, status_buf
C24E: 364323   [289]            ld   (hl), 'C' \ inc hl
C251: 364823   [305]            ld   (hl), 'H' \ inc hl
C254: 364B23   [321]            ld   (hl), 'K' \ inc hl
C257: 363D23   [337]            ld   (hl), '=' \ inc hl
C25A: 7A       [341]            ld   a, d
C25B: CD59C5   [358]            call hex_byte
C25E: 7B       [362]            ld   a, e
C25F: CD59C5   [379]            call hex_byte
C262: 3600     [389]            ld   (hl), 0
C264: 1600     [396]            ld   d, 0
C266: 1E02     [403]            ld   e, 2
C268: CD1501   [420]            call CRSRSET
C26B: 217DCB   [430]            ld   hl, status_buf
C26E: 54       [434]            ld   d, h
C26F: 5D       [438]            ld   e, l
C270: AF       [442]            xor  a
C271: CDEB00   [459]            call PRTASTR
                        
C274: 1600     [466]            ld   d, 0
C276: 1E03     [473]            ld   e, 3
C278: CD1501   [490]            call CRSRSET
C27B: 21CAC6   [500]            ld   hl, lbl_press_key
C27E: 3AC6CB   [513]            ld   a, (page_and)
C281: 3C       [517]            inc  a
C282: 2003     [524|529]        jr   nz, rde_prompt           ; some byte is not FFH
C284: 21DCC6   [534]            ld   hl, lbl_empty_key        ; all FFH: open bus or erased
C287:                   rde_prompt:
C287: 54       [ 4]             ld   d, h
C288: 5D       [ 8]             ld   e, l
C289: AF       [12]             xor  a
C28A: CDEB00   [29]             call PRTASTR
C28D: CD6601   [46]             call KEYGET
                        
C290: FE53     [53]             cp   'S'                      ; skip this page -- no re-send of an
C292: 280D     [60|65]          jr   z, rde_skip              ; already-captured page (no display
C294: FE73     [67]             cp   's'                      ; hint needed; any other key sends)
C296: 2809     [74|79]          jr   z, rde_skip
                        
                                ; The display/keypress IOCS calls above restored bank and Port 3DH
                                ; on return, so the page is still mapped.
C298: DD6E04   [93]             ld   l, (ix+4)               ; reload base address -- clobbered above
C29B: DD6603   [112]            ld   h, (ix+3)
C29E: C3CAC2   [122]            jp   SEND_PAGE                ; tail call: CF/A propagate to caller
                        
C2A1:                   rde_skip:
C2A1: AF       [ 4]             xor  a                       ; success, nothing sent, CF=0
C2A2: C9       [14]             ret
                        
                        ; ============================================================================
                        ; SET_PORT3D: A = Port 3DH value (04H = bank 3, 00H = hidden bank 3b).
                        ; Writes the firmware's copy at F07DH first, then the port -- same order as
                        ; the ROM's own ROMSELN (08A5H) -- so an interrupt in between restores the
                        ; new value, not the old one.
C2A3:                   SET_PORT3D:
C2A3: 327DF0   [13]             ld   (PORT3D_M), a
C2A6: D33D     [24]             out  (PORT3D), a
C2A8: C9       [34]             ret
                        
                        ; ============================================================================
                        ; COMPUTE_CHECKSUM: HL = base address of a 16KB (0x4000-byte) page.
                        ; Returns DE = 16-bit additive checksum (sum of all bytes, mod 65536) and
                        ; (page_and) = AND of all bytes (FFH = the page reads all FFH).
                        ; HL is preserved.
C2A9:                   COMPUTE_CHECKSUM:
C2A9: E5       [11]             push hl
C2AA: 010040   [21]             ld   bc, 0x4000
C2AD: 110000   [31]             ld   de, 0x0000
C2B0: 3EFF     [38]             ld   a, 0xFF
C2B2: 32C6CB   [51]             ld   (page_and), a
C2B5:                   cs_loop:
C2B5: 3AC6CB   [13]             ld   a, (page_and)
C2B8: A6       [20]             and  (hl)
C2B9: 32C6CB   [33]             ld   (page_and), a
C2BC: 7E       [40]             ld   a, (hl)
C2BD: 83       [44]             add  a, e
C2BE: 5F       [48]             ld   e, a
C2BF: 3001     [55|60]          jr   nc, cs_noc
C2C1: 14       [59]             inc  d
C2C2:                   cs_noc:
C2C2: 23       [ 6]             inc  hl
C2C3: 0B       [12]             dec  bc
C2C4: 78       [16]             ld   a, b
C2C5: B1       [20]             or   c
C2C6: 20ED     [27|32]          jr   nz, cs_loop
C2C8: E1       [37]             pop  hl
C2C9: C9       [47]             ret
                        
                        ; ============================================================================
                        ; SEND_PAGE: HL = base address of a 16KB (0x4000-byte) page. Sends every
                        ; byte over COM1: via CSNDA. On success returns CF=0. On a CSNDA error,
                        ; stops immediately and returns CF=1, A=CSNDA's error byte (b0=timeout,
                        ; b1=BREAK pressed) -- no channel parameter needed, per the IOCS table.
C2CA:                   SEND_PAGE:
C2CA: 010040   [10]             ld   bc, 0x4000
C2CD:                   sp_loop:
C2CD: 7E       [ 7]             ld   a, (hl)
C2CE: E5       [18]             push hl
C2CF: C5       [29]             push bc
C2D0: 0E03     [36]             ld   c, S_CSNDA
C2D2: CDD801   [53]             call SERIAL
C2D5: C1       [63]             pop  bc
C2D6: E1       [73]             pop  hl
C2D7: 3808     [80|85]          jr   c, sp_error
C2D9: 23       [86]             inc  hl
C2DA: 0B       [92]             dec  bc
C2DB: 78       [96]             ld   a, b
C2DC: B1       [100]            or   c
C2DD: 20EE     [107|112]        jr   nz, sp_loop
C2DF: AF       [111]            xor  a                      ; success: A=0, CF=0
C2E0: C9       [121]            ret
C2E1:                   sp_error:
C2E1: 37       [ 4]             scf                          ; CF=1; A already holds CSNDA's error byte
C2E2: C9       [14]             ret
                        
                        ; ============================================================================
                        ; LH5803_FETCH_BYTE: HL = LH-5803-view source address to read. Returns the
                        ; fetched byte in A. Runs the 2-byte `lda (x) / rtn` stub (lh5803_stub) on
                        ; the LH-5803 via CALLH, with X preloaded from HL (CMDZ=30H) and A read back
                        ; from PARA on return.
                        ;
                        ; CALLH clobbers all Z-80 registers (documented) -- callers must not expect
                        ; anything but A to survive a call here, and must keep their own loop state
                        ; (address/counter/accumulator) in memory, not registers, across it.
C2E3:                   LH5803_FETCH_BYTE:
C2E3: 3E30     [ 7]             ld   a, 0x30                ; CMDZ=30H: load PARA..PARUH before entry
C2E5: 3202F0   [20]             ld   (CMDZ), a
C2E8: 2206F0   [36]             ld   (PARXL), hl            ; HL -> PARXL/PARXH (L=low, H=high)
C2EB: 217B4B   [46]             ld   hl, lh5803_stub - 0x8000  ; stub's LH-5803-view entry address
C2EE: 220CF0   [62]             ld   (PARPCL), hl
C2F1: AF       [66]             xor  a
C2F2: 320EF0   [79]             ld   (PARBAN), a            ; PV(0) -- neither the stub's home (4000-7FFF)
                                                             ; nor the ROM being read (C000-FFFF) is
                                                             ; documented as PV-banked
C2F5: F3       [83]             di
C2F6: CDC601   [100]            call CALLH
C2F9: FB       [104]            ei
C2FA: 3A05F0   [117]            ld   a, (PARA)
C2FD: C9       [127]            ret
                        
                        ; ============================================================================
                        ; LH5803_SELFTEST: fetches LH-5803 address C000H twice in a row and compares
                        ; the two results. Returns CF=0 if they agree, CF=1 if they don't. Run once
                        ; before trusting a full LH5803 dump.
C2FE:                   LH5803_SELFTEST:
C2FE: 2100C0   [10]             ld   hl, 0xC000
C301: CDE3C2   [27]             call LH5803_FETCH_BYTE
C304: 32CDCB   [40]             ld   (lh5803_selftest_tmp), a
C307: 2100C0   [50]             ld   hl, 0xC000
C30A: CDE3C2   [67]             call LH5803_FETCH_BYTE
C30D: 47       [71]             ld   b, a
C30E: 3ACDCB   [84]             ld   a, (lh5803_selftest_tmp)
C311: B8       [88]             cp   b
C312: 2802     [95|100]         jr   z, lh5803_selftest_ok
C314: 37       [99]             scf
C315: C9       [109]            ret
C316:                   lh5803_selftest_ok:
C316: B7       [ 4]             or   a                      ; clear carry
C317: C9       [14]             ret
                        
                        ; ============================================================================
                        ; LH5803_COMPUTE_CHECKSUM: sums all 16384 bytes of LH-5803 C000H-FFFFH via
                        ; LH5803_FETCH_BYTE. Returns DE = 16-bit additive checksum (mod 65536). All
                        ; loop state lives in memory (lh5803_addr/lh5803_count/lh5803_chk), not
                        ; registers, since LH5803_FETCH_BYTE's CALLH clobbers everything.
C318:                   LH5803_COMPUTE_CHECKSUM:
C318: 2100C0   [10]             ld   hl, 0xC000
C31B: 22C7CB   [26]             ld   (lh5803_addr), hl
C31E: 210040   [36]             ld   hl, 0x4000
C321: 22C9CB   [52]             ld   (lh5803_count), hl
C324: 210000   [62]             ld   hl, 0x0000
C327: 22CBCB   [78]             ld   (lh5803_chk), hl
C32A:                   lcs_loop:
C32A: 2AC7CB   [16]             ld   hl, (lh5803_addr)
C32D: CDE3C2   [33]             call LH5803_FETCH_BYTE      ; A = byte
C330: 2ACBCB   [49]             ld   hl, (lh5803_chk)
C333: 85       [53]             add  a, l
C334: 6F       [57]             ld   l, a
C335: 3001     [64|69]          jr   nc, lcs_noc
C337: 24       [68]             inc  h
C338:                   lcs_noc:
C338: 22CBCB   [16]             ld   (lh5803_chk), hl
C33B: 2AC7CB   [32]             ld   hl, (lh5803_addr)
C33E: 23       [38]             inc  hl
C33F: 22C7CB   [54]             ld   (lh5803_addr), hl
C342: 2AC9CB   [70]             ld   hl, (lh5803_count)
C345: 2B       [76]             dec  hl
C346: 22C9CB   [92]             ld   (lh5803_count), hl
C349: 7C       [96]             ld   a, h
C34A: B5       [100]            or   l
C34B: 20DD     [107|112]        jr   nz, lcs_loop
C34D: ED5BCBCB [127]            ld   de, (lh5803_chk)
C351: C9       [137]            ret
                        
                        ; ============================================================================
                        ; LH5803_SEND: sends all 16384 bytes of LH-5803 C000H-FFFFH over COM1: via
                        ; CSNDA, fetching each one through LH5803_FETCH_BYTE. Same CF/A error-return
                        ; convention as SEND_PAGE. No Port 3DH involvement at all -- this path never
                        ; touches Z-80 bank switching.
C352:                   LH5803_SEND:
C352: 2100C0   [10]             ld   hl, 0xC000
C355: 22C7CB   [26]             ld   (lh5803_addr), hl
C358: 210040   [36]             ld   hl, 0x4000
C35B: 22C9CB   [52]             ld   (lh5803_count), hl
C35E:                   lsend_loop:
C35E: 2AC7CB   [16]             ld   hl, (lh5803_addr)
C361: CDE3C2   [33]             call LH5803_FETCH_BYTE      ; A = byte
C364: 0E03     [40]             ld   c, S_CSNDA
C366: CDD801   [57]             call SERIAL
C369: 3814     [64|69]          jr   c, lsend_error
C36B: 2AC7CB   [80]             ld   hl, (lh5803_addr)
C36E: 23       [86]             inc  hl
C36F: 22C7CB   [102]            ld   (lh5803_addr), hl
C372: 2AC9CB   [118]            ld   hl, (lh5803_count)
C375: 2B       [124]            dec  hl
C376: 22C9CB   [140]            ld   (lh5803_count), hl
C379: 7C       [144]            ld   a, h
C37A: B5       [148]            or   l
C37B: 20E1     [155|160]        jr   nz, lsend_loop
C37D: AF       [159]            xor  a                      ; success: A=0, CF=0
C37E: C9       [169]            ret
C37F:                   lsend_error:
C37F: 37       [ 4]             scf                          ; CF=1; A already holds CSNDA's error byte
C380: C9       [14]             ret
                        
