C2FB: CDD4C2   [67]             call LH5803_FETCH_BYTE
C2FE: 47       [71]             ld   b, a
C2FF: 3A69C9   [84]             ld   a, (lh5803_selftest_tmp)
C302: B8       [88]             cp   b
C303: 2802     [95|100]         jr   z, lh5803_selftest_ok
C305: 37       [99]             scf
C306: C9       [109]            ret
C307:                   lh5803_selftest_ok:
C307: B7       [ 4]             or   a                      ; clear carry
C308: C9       [14]             ret
                        
