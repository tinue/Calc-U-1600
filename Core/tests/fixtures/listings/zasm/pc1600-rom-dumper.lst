C355: 0E03     [40]             ld   c, S_CSNDA
C357: CDD801   [57]             call SERIAL
C35A: 3814     [64|69]          jr   c, lsend_error
C35C: 2A63C9   [80]             ld   hl, (lh5803_addr)
C35F: 23       [86]             inc  hl
C360: 2263C9   [102]            ld   (lh5803_addr), hl
C363: 2A65C9   [118]            ld   hl, (lh5803_count)
C366: 2B       [124]            dec  hl
C367: 2265C9   [140]            ld   (lh5803_count), hl
C36A: 7C       [144]            ld   a, h
C36B: B5       [148]            or   l
C36C: 20E1     [155|160]        jr   nz, lsend_loop
C36E: AF       [159]            xor  a                      ; success: A=0, CF=0
C36F: C9       [169]            ret
C370:                   lsend_error:
C370: 37       [ 4]             scf                          ; CF=1; A already holds CSNDA's error byte
C371: C9       [14]             ret
                        
