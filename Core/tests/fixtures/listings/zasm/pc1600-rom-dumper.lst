                        ; --------------------------------------
                        ; zasm: assemble "pc1600-rom-dumper.asm"
                        ; date: 2026-09-25 16:23:36
                        ; --------------------------------------


                        ; ============================================================================
                        ; PC-1600 ROM Bank Dumper
                        ;
                        ; Menu-driven Z-80 ML program for the Sharp PC-1600:
                        ;
                        ;   1 = SWEEP -- pages every known Z-80-addressable ROM bank into the CPU's
                        ;       address space in turn and shows a short hex sample on the LCD,
                        ;       pausing for a keypress between screens. Diagnostic tool: confirms
                        ;       which banks hold real ROM vs. open bus, and lets you eyeball a
                        ;       bank's content before committing to a full dump.
                        ;
                        ;   2 = DUMP+SEND -- pages in the 7 banks confirmed to hold real ROM content
                        ;       (see dump_table below), shows a 16-bit checksum per page, and on a
                        ;       keypress sends the full 16KB page out over COM1: via the serial
                        ;       IOCS (CSNDA). Press S to skip a page instead of sending it. COM1:
                        ;       itself must already be configured (SETCOM/OUTSTAT/SNDSTAT/RCVSTAT/
                        ;       INIT) from BASIC before this program is CALLed -- see the
                        ;       accompanying .pc1600 preset / README for the exact sequence. This
                        ;       program only calls CSNDA; it never touches CWCOM/CESND/CCLRSB.
                        ;
                        ;   3 = LH5803 ROM -- dumps the LH-5803 co-processor's own private 16KB ROM
                        ;       (LH-5803 view C000H-FFFFH), which no Z-80 bank-switching combination
                        ;       can reach -- it's the *other* half of the same physical chip as
                        ;       Bank 6/CS123, addressed only from the LH-5803's own side. Reached
                        ;       via the CALLH bridge (CALL 01C6H): a 2-byte LH-5801 stub (`lda (x)`
                        ;       / `rtn`) placed in the shared 4000-7FFF/C000-FFFF RAM fetches one
                        ;       byte per round-trip, using X as the source pointer and A/PARA as
                        ;       the return path. Same checksum-then-keypress-then-send UX as
                        ;       DUMP+SEND, but as a single fixed 16KB region rather than 7 banks.
                        ;
                        ; Runs entirely from C000-FFFF (page 3, bank 0 -- never touched by this
                        ; program) so paging banks into 4000-7FFF/8000-BFFF never disturbs the code
                        ; that is doing the paging. All display/IOCS calls used here live in the
                        ; always-resident bank 0 (0000-3FFF), so they too are unaffected.
                        ;
                        ; Assumes the machine is already NEW'd with enough S0: space to hold this
                        ; program; the .pc1600 preset / load sequence handles that.
                        ;
                        ; Hardware note -- Port 3DH (hidden-BASIC-ROM sub-bank select, bit b2):
                        ; clearing b2 selects Bank 3b instead of Bank 3 at 4000-7FFF. This port is
                        ; write-only. Getting a correct read of Bank 3/3b requires two things this
                        ; program does everywhere it touches the port:
                        ;   1. BANKSET before the Port 3DH write, not after (the ROM's own BANKSET
                        ;      routine does not preserve an out-of-order Port 3DH state).
                        ;   2. Interrupts briefly disabled (DI/EI) around the write and the read
                        ;      that follows it. The PC-1600's own interrupt handlers (keyboard
                        ;      scan / the 1/64s timer tick) do not preserve Port 3DH's state, so a
                        ;      read landing between the write and the actual memory access can
                        ;      silently see the wrong bank. For the serial send specifically (too
                        ;      long, ~17s at 9600 baud, to run under one DI), Port 3DH is instead
                        ;      re-asserted before every byte, each reassert individually DI/EI-
                        ;      guarded.
                        ; ============================================================================
                        
                        #target bin
                        
                        ; ---- IOCS entry points (TRM, all in Bank 0 / always resident) ----
0190:                   BANKSET     equ 0x0190      ; A=bank, B=page(0-3) -> set bank
0193:                   BANKREAD    equ 0x0193      ; B=page -> A=current bank
018D:                   MEMORYCHK   equ 0x018D      ; D=bank, E=addr high byte -> CF=1/A=00 none, CF=0/A=01 RAM, CF=0/A=03 ROM
0112:                   CLS         equ 0x0112
0115:                   CRSRSET     equ 0x0115      ; D=X(0-25), E=Y(0-3)
00EB:                   PRTASTR     equ 0x00EB      ; DE=addr, A=terminator byte -> prints until terminator
0166:                   KEYGET      equ 0x0166      ; waits for a key; CF=0 -> A=key code
                        
                        ; ---- Serial IOCS gateway (PC-1600-Serial-Commands.md Part 2) ----
01D8:                   SERIAL      equ 0x01D8      ; C=routine#, D=channel(1=COM1:) as needed -> dispatch
0003:                   S_CSNDA     equ 0x03        ; A=byte to send -> CF=1/A=error byte on failure
                        
003D:                   PORT3D      equ 0x3D        ; hidden-BASIC-ROM sub-bank select (bit 2; not readable via IN)
                        
                        ; ---- Z-80 -> LH-5803 bridge (PC-1600-CPU-LH5803-Compat.md Part 3) ----
01C6:                   CALLH       equ 0x01C6      ; hands off to an LH-5803 subroutine, returns when it RTNs
F002:                   CMDZ        equ 0xF002      ; 20H = no params in, 30H = load PARA..PARUH before entry
F005:                   PARA        equ 0xF005      ; -> LH-5803 A on entry; <- LH-5803 A on return
F006:                   PARXL       equ 0xF006      ; -> LH-5803 XL (low byte of the X reg pair)
F007:                   PARXH       equ 0xF007      ; -> LH-5803 XH (high byte)
F00C:                   PARPCL      equ 0xF00C      ; subroutine entry address, low byte (LH-5803-view)
F00D:                   PARPCH      equ 0xF00D      ; subroutine entry address, high byte
F00E:                   PARBAN      equ 0xF00E      ; subroutine bank: 00H = PV(0), 01H = PV(1)
                        
C0C5:                   #code CODE, 0xC0C5
                        
                        ; ============================================================================
                        ; Entry point: menu -- 1 = sweep, 2 = dump+send, 3 = LH5803 ROM.
C0C5:                   start:
C0C5: CD1201   [17]             call CLS
C0C8: 2116C6   [27]             ld   hl, lbl_menu1
C0CB: CDBCC4   [44]             call show_label
C0CE: 1600     [51]             ld   d, 0
C0D0: 1E01     [58]             ld   e, 1
C0D2: CD1501   [75]             call CRSRSET
C0D5: 2128C6   [85]             ld   hl, lbl_menu2
C0D8: 54       [89]             ld   d, h
C0D9: 5D       [93]             ld   e, l
C0DA: AF       [97]             xor  a
C0DB: CDEB00   [114]            call PRTASTR
                        
C0DE: 1600     [121]            ld   d, 0
C0E0: 1E02     [128]            ld   e, 2
C0E2: CD1501   [145]            call CRSRSET
C0E5: 213DC6   [155]            ld   hl, lbl_menu3
C0E8: 54       [159]            ld   d, h
C0E9: 5D       [163]            ld   e, l
C0EA: AF       [167]            xor  a
C0EB: CDEB00   [184]            call PRTASTR
                        
C0EE:                   menu_wait:
C0EE: CD6601   [17]             call KEYGET
C0F1: FE31     [24]             cp   '1'
C0F3: CA02C1   [34|34]          jp   z, sweep_start
C0F6: FE32     [41]             cp   '2'
C0F8: CA80C1   [51|51]          jp   z, dump_start
C0FB: FE33     [58]             cp   '3'
C0FD: CA72C3   [68|68]          jp   z, lh5803_dump_start
C100: 18EC     [80]             jr   menu_wait
                        
                        ; ============================================================================
                        ; Sweep: walk every known bank, page 0/1/2, showing a hex sample on the LCD.
C102:                   sweep_start:
C102: CD1201   [17]             call CLS
                        
                                ; ---- Page 0 sample: bank 0 is always resident, no BANKSET needed ----
C105: 21DFC7   [27]             ld   hl, lbl_page0
C108: CDBCC4   [44]             call show_label
C10B: 3E00     [51]             ld   a, 0                  ; "bank 0" for the BR=/CHK= line (informational only)
C10D: 1600     [58]             ld   d, 0
C10F: 1E00     [65]             ld   e, 0x00
C111: CDCCC4   [82]             call show_status           ; MEMORYCHK D=0,E=00 -- page-0 bank 0
C114: 3E04     [89]             ld   a, 0x04                ; page 0 doesn't involve Port 3DH
C116: 3262C9   [102]            ld   (cur_port3d), a
C119: 210000   [112]            ld   hl, 0x0000
C11C: 1131C9   [122]            ld   de, line_buf
C11F: CD3DC5   [139]            call BUILD_HEX_LINE
C122: 1600     [146]            ld   d, 0
C124: 1E02     [153]            ld   e, 2
C126: 2131C9   [163]            ld   hl, line_buf
C129: CD5DC5   [180]            call DISPLAY_LINE_AT
C12C: CD87C5   [197]            call wait_key
                        
                                ; ---- Page 1 sweep ----
C12F: DD218BC5 [211]            ld   ix, page1_table
C133:                   p1_loop:
C133: DD7E00   [19]             ld   a, (ix+0)
C136: FEFF     [26]             cp   0xFF
C138: CA4AC1   [36|36]          jp   z, p2_start
C13B: CD08C4   [53]             call run_page1_entry
C13E: DDE5     [68]             push ix
C140: E1       [78]             pop  hl
C141: 110500   [88]             ld   de, 5      ; page1_table record size: bank,port3d,mode,lbl_lo,lbl_hi
C144: 19       [99]             add  hl, de
C145: E5       [110]            push hl
C146: DDE1     [124]            pop  ix
C148: 18E9     [136]            jr   p1_loop
                        
                        ; ============================================================================
C14A:                   p2_start:
                                ; ---- Page 2 sweep ----
C14A: DD21B9C5 [14]             ld   ix, page2_table
C14E:                   p2_loop:
C14E: DD7E00   [19]             ld   a, (ix+0)
C151: FEFF     [26]             cp   0xFF
C153: CA65C1   [36|36]          jp   z, all_done
C156: CD7DC4   [53]             call run_page2_entry
C159: DDE5     [68]             push ix
C15B: E1       [78]             pop  hl
C15C: 110400   [88]             ld   de, 4      ; page2_table record size: bank,mode,lbl_lo,lbl_hi
C15F: 19       [99]             add  hl, de
C160: E5       [110]            push hl
C161: DDE1     [124]            pop  ix
C163: 18E9     [136]            jr   p2_loop
                        
                        ; ============================================================================
C165:                   all_done:
                                ; Restore known-good defaults before returning to BASIC:
                                ; page 1 -> bank 0, page 2 -> bank 6 (system ROM), hidden-BASIC off.
C165: AF       [ 4]             xor  a
C166: 0601     [11]             ld   b, 1
C168: CD9001   [28]             call BANKSET
C16B: 3E06     [35]             ld   a, 6
C16D: 0602     [42]             ld   b, 2
C16F: CD9001   [59]             call BANKSET
C172: 3E04     [66]             ld   a, 0x04
C174: D33D     [77]             out  (PORT3D), a
                        
C176: CD1201   [94]             call CLS
C179: 21F3C7   [104]            ld   hl, lbl_done
C17C: CDBCC4   [121]            call show_label
C17F: C9       [131]            ret
                        
                        ; ============================================================================
                        ; Dump+send: page in each of the 7 confirmed-ROM banks in turn, show a
                        ; checksum, wait for a keypress (S = skip, anything else = send), then send
                        ; the full 16KB page over COM1:.
C180:                   dump_start:
C180: CD1201   [17]             call CLS
                        
C183: DD21D6C5 [31]             ld   ix, dump_table
C187:                   dump_loop:
C187: DD7E00   [19]             ld   a, (ix+0)
C18A: FEFF     [26]             cp   0xFF
C18C: CAD4C1   [36|36]          jp   z, dump_done
C18F: CDEFC1   [53]             call run_dump_entry
C192: 3006     [60|65]          jr   nc, dump_next
C194: 3261C9   [73]             ld   (send_err_code), a     ; CSNDA reported an error -- save the error
C197: C3A6C1   [83]             jp   dump_error             ; byte before CLS/show_label clobber A
C19A:                   dump_next:
C19A: DDE5     [15]             push ix
C19C: E1       [25]             pop  hl
C19D: 110900   [35]             ld   de, 9      ; dump_table record size: bank,port3d,page,base_hi,
                                                 ; base_lo,lbl_lo,lbl_hi,fn_lo,fn_hi
C1A0: 19       [46]             add  hl, de
C1A1: E5       [57]             push hl
C1A2: DDE1     [71]             pop  ix
C1A4: 18E1     [83]             jr   dump_loop
                        
                        ; ============================================================================
C1A6:                   dump_error:
C1A6: CD1201   [17]             call CLS
C1A9: 214AC6   [27]             ld   hl, lbl_error
C1AC: CDBCC4   [44]             call show_label
C1AF: 2119C9   [54]             ld   hl, status_buf
C1B2: 364523   [70]             ld   (hl), 'E' \ inc hl
C1B5: 365223   [86]             ld   (hl), 'R' \ inc hl
C1B8: 363D23   [102]            ld   (hl), '=' \ inc hl
C1BB: 3A61C9   [115]            ld   a, (send_err_code)
C1BE: CD71C5   [132]            call hex_byte
C1C1: 3600     [142]            ld   (hl), 0
C1C3: 1600     [149]            ld   d, 0
C1C5: 1E01     [156]            ld   e, 1
C1C7: CD1501   [173]            call CRSRSET
C1CA: 2119C9   [183]            ld   hl, status_buf
C1CD: 54       [187]            ld   d, h
C1CE: 5D       [191]            ld   e, l
C1CF: AF       [195]            xor  a
C1D0: CDEB00   [212]            call PRTASTR
C1D3: C9       [222]            ret
                        
                        ; ============================================================================
C1D4:                   dump_done:
                                ; Restore known-good defaults before returning to BASIC, same as
                                ; Stage 1's all_done:.
C1D4: AF       [ 4]             xor  a
C1D5: 0601     [11]             ld   b, 1
C1D7: CD9001   [28]             call BANKSET
C1DA: 3E06     [35]             ld   a, 6
C1DC: 0602     [42]             ld   b, 2
C1DE: CD9001   [59]             call BANKSET
C1E1: 3E04     [66]             ld   a, 0x04
C1E3: D33D     [77]             out  (PORT3D), a
                        
C1E5: CD1201   [94]             call CLS
C1E8: 21F3C7   [104]            ld   hl, lbl_done
C1EB: CDBCC4   [121]            call show_label
C1EE: C9       [131]            ret
                        
                        ; ============================================================================
                        ; run_dump_entry: (ix) = { bank, port3d, page, base_hi, base_lo, lbl_lo,
                        ;                           lbl_hi, fn_lo, fn_hi }
                        ;   port3d = 0xFF means "don't touch" (page 0/page 2 entries).
                        ;   page = 0 means "always resident, no BANKSET call" (the page-0 entry).
                        ; Returns: CF/A as SEND_PAGE (CF=1, A=error byte, on a CSNDA failure).
C1EF:                   run_dump_entry:
C1EF: DD7E02   [19]             ld   a, (ix+2)              ; page number
C1F2: B7       [23]             or   a
C1F3: 2808     [30|35]          jr   z, rde_no_bankset      ; page 0 -- always resident, nothing to switch
C1F5: 4F       [34]             ld   c, a                   ; c = page number
C1F6: DD7E00   [53]             ld   a, (ix+0)              ; a = bank number
C1F9: 41       [57]             ld   b, c                   ; b = page number
C1FA: CD9001   [74]             call BANKSET
C1FD:                   rde_no_bankset:
C1FD: DD7E01   [19]             ld   a, (ix+1)              ; port3d value, or 0xFF = don't touch
C200: FEFF     [26]             cp   0xFF
C202: 2002     [33|38]          jr   nz, rde_have_port3d
C204: 3E04     [40]             ld   a, 0x04                ; "don't touch" -> the safe/normal default
C206:                   rde_have_port3d:
C206: 3262C9   [13]             ld   (cur_port3d), a        ; SEND_PAGE reasserts this every byte later
                        
C209: F3       [17]             di
C20A: D33D     [28]             out  (PORT3D), a
                        
                                ; checksum over the 16KB page, base address = (ix+3):(ix+4) --
                                ; the actual hardware read, done immediately, interrupts disabled.
C20C: DD6E04   [47]             ld   l, (ix+4)
C20F: DD6603   [66]             ld   h, (ix+3)
C212: CD9FC2   [83]             call COMPUTE_CHECKSUM       ; HL preserved, DE = checksum
C215: FB       [87]             ei
C216: D5       [98]             push de                     ; stash across the display calls below
                        
C217: CD1201   [115]            call CLS
C21A: DD6E05   [134]            ld   l, (ix+5)
C21D: DD6606   [153]            ld   h, (ix+6)
C220: CDBCC4   [170]            call show_label
                        
                                ; filename hint on line 1
C223: 1600     [177]            ld   d, 0
C225: 1E01     [184]            ld   e, 1
C227: CD1501   [201]            call CRSRSET
C22A: DD6E07   [220]            ld   l, (ix+7)
C22D: DD6608   [239]            ld   h, (ix+8)
C230: 54       [243]            ld   d, h
C231: 5D       [247]            ld   e, l
C232: AF       [251]            xor  a
C233: CDEB00   [268]            call PRTASTR
                        
C236: D1       [278]            pop  de                     ; recover the checksum computed above
C237: 2119C9   [288]            ld   hl, status_buf
C23A: 364323   [304]            ld   (hl), 'C' \ inc hl
C23D: 364823   [320]            ld   (hl), 'H' \ inc hl
C240: 364B23   [336]            ld   (hl), 'K' \ inc hl
C243: 363D23   [352]            ld   (hl), '=' \ inc hl
C246: 7A       [356]            ld   a, d
C247: CD71C5   [373]            call hex_byte
C24A: 7B       [377]            ld   a, e
C24B: CD71C5   [394]            call hex_byte
C24E: 3600     [404]            ld   (hl), 0
C250: 1600     [411]            ld   d, 0
C252: 1E02     [418]            ld   e, 2
C254: CD1501   [435]            call CRSRSET
C257: 2119C9   [445]            ld   hl, status_buf
C25A: 54       [449]            ld   d, h
C25B: 5D       [453]            ld   e, l
C25C: AF       [457]            xor  a
C25D: CDEB00   [474]            call PRTASTR
                        
C260: 1600     [481]            ld   d, 0
C262: 1E03     [488]            ld   e, 3
C264: CD1501   [505]            call CRSRSET
C267: 215FC6   [515]            ld   hl, lbl_press_key
C26A: 54       [519]            ld   d, h
C26B: 5D       [523]            ld   e, l
C26C: AF       [527]            xor  a
C26D: CDEB00   [544]            call PRTASTR
C270: CD6601   [561]            call KEYGET
                        
C273: FE53     [568]            cp   'S'                      ; skip this page -- no re-send of an
C275: 2826     [575|580]        jr   z, rde_skip              ; already-captured page (no display
C277: FE73     [582]            cp   's'                      ; hint needed; any other key sends)
C279: 2822     [589|594]        jr   z, rde_skip
                        
                                ; Re-assert bank/Port 3DH immediately before the actual send: the
                                ; checksum above was read under DI, but the display/keypress wait
                                ; since then ran with interrupts enabled and may have disturbed
                                ; Port 3DH again. SEND_PAGE itself reasserts before every byte too
                                ; (the send is far too long to cover with a single DI), so this is
                                ; just what gets the very first bytes right before its first
                                ; reassert point.
C27B: DD7E02   [608]            ld   a, (ix+2)              ; page number
C27E: B7       [612]            or   a
C27F: 2808     [619|624]        jr   z, rde_no_bankset2
C281: 4F       [623]            ld   c, a
C282: DD7E00   [642]            ld   a, (ix+0)              ; bank number
C285: 41       [646]            ld   b, c
C286: CD9001   [663]            call BANKSET
C289:                   rde_no_bankset2:
C289: DD7E01   [19]             ld   a, (ix+1)              ; port3d value, or 0xFF = don't touch
C28C: FEFF     [26]             cp   0xFF
C28E: 2804     [33|38]          jr   z, rde_no_port3d2
C290: F3       [37]             di
C291: D33D     [48]             out  (PORT3D), a
C293: FB       [52]             ei
C294:                   rde_no_port3d2:
                        
C294: DD6E04   [19]             ld   l, (ix+4)               ; reload base address -- clobbered above
C297: DD6603   [38]             ld   h, (ix+3)
C29A: C3B4C2   [48]             jp   SEND_PAGE                ; tail call: CF/A propagate to caller
                        
C29D:                   rde_skip:
C29D: AF       [ 4]             xor  a                       ; success, nothing sent, CF=0
C29E: C9       [14]             ret
                        
                        ; ============================================================================
                        ; COMPUTE_CHECKSUM: HL = base address of a 16KB (0x4000-byte) page.
                        ; Returns DE = 16-bit additive checksum (sum of all bytes, mod 65536).
                        ; HL is preserved.
C29F:                   COMPUTE_CHECKSUM:
C29F: E5       [11]             push hl
C2A0: 010040   [21]             ld   bc, 0x4000
C2A3: 110000   [31]             ld   de, 0x0000
C2A6:                   cs_loop:
C2A6: 7E       [ 7]             ld   a, (hl)
C2A7: 83       [11]             add  a, e
C2A8: 5F       [15]             ld   e, a
C2A9: 3001     [22|27]          jr   nc, cs_noc
C2AB: 14       [26]             inc  d
C2AC:                   cs_noc:
C2AC: 23       [ 6]             inc  hl
C2AD: 0B       [12]             dec  bc
C2AE: 78       [16]             ld   a, b
C2AF: B1       [20]             or   c
C2B0: 20F4     [27|32]          jr   nz, cs_loop
C2B2: E1       [37]             pop  hl
C2B3: C9       [47]             ret
                        
                        ; ============================================================================
                        ; SEND_PAGE: HL = base address of a 16KB (0x4000-byte) page. Sends every
                        ; byte over COM1: via CSNDA. On success returns CF=0. On a CSNDA error,
                        ; stops immediately and returns CF=1, A=CSNDA's error byte (b0=timeout,
                        ; b1=BREAK pressed) -- no channel parameter needed, per the IOCS table.
                        ;
                        ; Port 3DH is re-asserted from cur_port3d before every byte (each reassert
                        ; individually DI/EI-guarded; CSNDA itself runs with interrupts enabled,
                        ; since the send is too long -- ~17s at 9600 baud -- to cover with a
                        ; single DI without starving whatever the serial IOCS needs interrupts
                        ; for).
C2B4:                   SEND_PAGE:
C2B4: 010040   [10]             ld   bc, 0x4000
C2B7:                   sp_loop:
C2B7: F3       [ 4]             di
C2B8: 3A62C9   [17]             ld   a, (cur_port3d)
C2BB: D33D     [28]             out  (PORT3D), a
C2BD: FB       [32]             ei
C2BE: 7E       [39]             ld   a, (hl)
C2BF: E5       [50]             push hl
C2C0: C5       [61]             push bc
C2C1: 0E03     [68]             ld   c, S_CSNDA
C2C3: CDD801   [85]             call SERIAL
C2C6: C1       [95]             pop  bc
C2C7: E1       [105]            pop  hl
C2C8: 3808     [112|117]        jr   c, sp_error
C2CA: 23       [118]            inc  hl
C2CB: 0B       [124]            dec  bc
C2CC: 78       [128]            ld   a, b
C2CD: B1       [132]            or   c
C2CE: 20E7     [139|144]        jr   nz, sp_loop
C2D0: AF       [143]            xor  a                      ; success: A=0, CF=0
C2D1: C9       [153]            ret
C2D2:                   sp_error:
C2D2: 37       [ 4]             scf                          ; CF=1; A already holds CSNDA's error byte
C2D3: C9       [14]             ret
                        
                        ; ============================================================================
                        ; LH5803_FETCH_BYTE: HL = LH-5803-view source address to read. Returns the
                        ; fetched byte in A. Runs the 2-byte `lda (x) / rtn` stub (lh5803_stub) on
                        ; the LH-5803 via CALLH, with X preloaded from HL (CMDZ=30H) and A read back
                        ; from PARA on return.
                        ;
                        ; CALLH clobbers all Z-80 registers (documented) -- callers must not expect
                        ; anything but A to survive a call here, and must keep their own loop state
                        ; (address/counter/accumulator) in memory, not registers, across it.
C2D4:                   LH5803_FETCH_BYTE:
C2D4: 3E30     [ 7]             ld   a, 0x30                ; CMDZ=30H: load PARA..PARUH before entry
C2D6: 3202F0   [20]             ld   (CMDZ), a
C2D9: 2206F0   [36]             ld   (PARXL), hl            ; HL -> PARXL/PARXH (L=low, H=high)
C2DC: 211749   [46]             ld   hl, lh5803_stub - 0x8000  ; stub's LH-5803-view entry address
C2DF: 220CF0   [62]             ld   (PARPCL), hl
C2E2: AF       [66]             xor  a
C2E3: 320EF0   [79]             ld   (PARBAN), a            ; PV(0) -- neither the stub's home (4000-7FFF)
                                                             ; nor the ROM being read (C000-FFFF) is
                                                             ; documented as PV-banked
C2E6: F3       [83]             di
C2E7: CDC601   [100]            call CALLH
C2EA: FB       [104]            ei
C2EB: 3A05F0   [117]            ld   a, (PARA)
C2EE: C9       [127]            ret
                        
                        ; ============================================================================
                        ; LH5803_SELFTEST: fetches LH-5803 address C000H twice in a row and compares
                        ; the two results. Returns CF=0 if they agree, CF=1 if they don't. Mirrors
                        ; the double-fetch check that originally caught the Port 3DH interrupt bug --
                        ; run once before trusting a full LH5803 dump.
C2EF:                   LH5803_SELFTEST:
C2EF: 2100C0   [10]             ld   hl, 0xC000
