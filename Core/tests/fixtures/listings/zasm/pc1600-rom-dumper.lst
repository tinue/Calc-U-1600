C315: 210000   [62]             ld   hl, 0x0000
C318: 2267C9   [78]             ld   (lh5803_chk), hl
C31B:                   lcs_loop:
C31B: 2A63C9   [16]             ld   hl, (lh5803_addr)
C31E: CDD4C2   [33]             call LH5803_FETCH_BYTE      ; A = byte
C321: 2A67C9   [49]             ld   hl, (lh5803_chk)
C324: 85       [53]             add  a, l
C325: 6F       [57]             ld   l, a
C326: 3001     [64|69]          jr   nc, lcs_noc
C328: 24       [68]             inc  h
C329:                   lcs_noc:
C329: 2267C9   [16]             ld   (lh5803_chk), hl
C32C: 2A63C9   [32]             ld   hl, (lh5803_addr)
C32F: 23       [38]             inc  hl
C330: 2263C9   [54]             ld   (lh5803_addr), hl
C333: 2A65C9   [70]             ld   hl, (lh5803_count)
C336: 2B       [76]             dec  hl
C337: 2265C9   [92]             ld   (lh5803_count), hl
C33A: 7C       [96]             ld   a, h
C33B: B5       [100]            or   l
C33C: 20DD     [107|112]        jr   nz, lcs_loop
C33E: ED5B67C9 [127]            ld   de, (lh5803_chk)
C342: C9       [137]            ret
                        
                        ; ============================================================================
                        ; LH5803_SEND: sends all 16384 bytes of LH-5803 C000H-FFFFH over COM1: via
                        ; CSNDA, fetching each one through LH5803_FETCH_BYTE. Same CF/A error-return
                        ; convention as SEND_PAGE. No Port 3DH involvement at all -- this path never
                        ; touches Z-80 bank switching.
