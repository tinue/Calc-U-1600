C3D8: 1E02     [430]            ld   e, 2
C3DA: CD1501   [447]            call CRSRSET
C3DD: 217DCB   [457]            ld   hl, status_buf
C3E0: 54       [461]            ld   d, h
C3E1: 5D       [465]            ld   e, l
C3E2: AF       [469]            xor  a
C3E3: CDEB00   [486]            call PRTASTR
                        
C3E6: 1600     [493]            ld   d, 0
C3E8: 1E03     [500]            ld   e, 3
C3EA: CD1501   [517]            call CRSRSET
C3ED: 21CAC6   [527]            ld   hl, lbl_press_key
C3F0: 54       [531]            ld   d, h
