# Default startup setup for the PC-1600 -- set it under Settings >
# "PC-1600 default preset" to have it applied whenever the PC-1600 is
# selected: CE-1600P plotter (with its CE-1600F floppy and the bundled
# "Formatted" disk), a CE-1600M in slot 1 and a CE-1601M in slot 2, set up
# as a RAM disk.

model: PC-1600

plotter: CE-1600P
floppy: Formatted

slot-1: CE-1600M
slot-2: CE-1601M

# NEW after reset
keys:
  - key: mode
  - type: NEW0
  - key: mode
# Initialize and partition the memory card
  - type: INIT"S2:","F"
  - type: INIT"S2:","M"
# Setup the com port for 9600, no flow control:
  - type: SETCOM "COM1:",9600,8,N,1,N,N
  - type: OUTSTAT "COM1:"
  - type: SNDSTAT "COM1:",28
  - type: RCVSTAT "COM1:",28
  - type: INIT "COM1:",8192
# Reserve Area II for LOAD and SAVE
  - key: shift
  - key: mode
  - type: NEW
  - key: rsv
  - type: "SAVE LOAD"
  - key: f1
  - type: SAVE"COM1:"@
  - key: f2
  - type: LOAD"COM1:"@
  - key: mode
  - key: rsv
  - key: rsv
# Collect some information:
  - type: M=MEM
  - type: S=DSKF"S2:"
  - type: X=DSKF"X:"
# Clear the display
  - key: shift
  - key: cl
# Print the information
  - type: PRINT"Memory:  ";M;"           Diskette:";X;"           Slot2:   ";S
  - key: enter
# Sync clock again
  - syncclock:
