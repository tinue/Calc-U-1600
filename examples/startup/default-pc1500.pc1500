# Default startup setup for the PC-1500 -- set it under Settings >
# "PC-1500 default preset" to have it applied whenever the PC-1500 is
# selected: CE-150 plotter + an unnamed CE-163F in the expansion slot.

model: PC-1500

plotter: ce150

memory-expansion:
  - modulespec: CE-163F

# Clear memory and go to RUN mode
keys:
  - type: NEW0
  - type: NEW&112
  - key: mode