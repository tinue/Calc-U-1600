# PC-1600 plotter test -- draws a Lissajous figure on the CE-150.

model: PC-1600

# CE-150 pen-plotter attached.
plotter: ce150

# Bring the machine into PRO mode to accept a typed-in program.
keys:
  - key: mode
  - type: NEW
  - type: MODE1

# `format: basic-binary` with a `.bas` path tokenizes the program while
# loading, which is much faster than simulated typing the ascii version.
program:
  path: lissajou-ce150-1600.bas
  format: basic-binary

# Back to RUN mode, then run it -- the figure plots on the virtual paper.
keys:
  - key: mode
  - type: RUN
  - wait: 600