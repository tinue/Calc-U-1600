5 "BIO"
30 "B"CLS :CLEAR :WAIT 0:TEXT :CSIZE 3:CURSOR
40 COLOR 3:GRAPH :PITCH 33
50 FOR I=0TO 4:GLCURSOR (300+I,12):LPRINT "BIORHYTHMEN":NEXT I
60 CLS :WAIT 0,S:TEXT :LF 2:CSIZE 2:COLOR 1:DIM N$(0)*30
70 INPUT "Name ";N$(0)
80 TAB ((80-(LEN (N$(0))+19))/2):LPRINT "für ";N$(0);" (*";
90 INPUT "Geburts-Tag ";T:INPUT "Monat  ";M:INPUT "Jahr  ";J:MM=M:JJ=J:LPRINT T;".";M;".";J;")"
100 ERASE N$():CLS
110 COLOR 0:LF 1:LPRINT "ab ";
120 CLS :INPUT "ab Monat ";MA:MO=MA
130 IF MA=1LPRINT "1. Januar ";
140 IF MA=2LPRINT "1. Februar ";
150 IF MA=3LPRINT "1. März ";
160 IF MA=4LPRINT "1. April ";
170 IF MA=5LPRINT "1. Mai ";
180 IF MA=6LPRINT "1. Juni ";
190 IF MA=7LPRINT "1. Juli ";
200 IF MA=8LPRINT "1. August ";
210 IF MA=9LPRINT "1. September ";
220 IF MA=10LPRINT "1. Oktober ";
230 IF MA=11LPRINT "1. November ";
240 IF MA=12LPRINT "1. Dezember ";
250 INPUT "Jahr     ";JA:JO=JA:LPRINT JA
260 TAB 18:COLOR 2:LPRINT "-- physisch   ";
270 COLOR 3:LPRINT "-- psychisch   ";
280 COLOR 1:LPRINT "-- intellektuell"
290 GOSUB 540:GOSUB 640
300 D=TX-TG:COLOR 0:GRAPH :ROTATE 3
310 GLCURSOR (20,-150):SORGN :GLCURSOR (-2,-80):LPRINT "-             +"
320 X=I*25:LLINE (0,-100)-(-0,115),0
330 FOR Z=1TO 31
340 IF Z=31AND I=30GOTO 420
350 IF Z=29AND I=28GOTO 420
360 X=Z*25
370 IF Z=1COLOR 3ELSE COLOR 0
380 LLINE (X,-100)-(X,115),0
390 Y=80:W=X+10:LLINE (W-14,115)-(W-14,Y),9
400 IF Z=1COLOR 3:LPRINT Z;".";MO;".":NEXT Z
410 COLOR 0:LPRINT Z:NEXT Z
420 LLINE (X,0)-(0,0),0
430 PH=INT (D/23):PH=D-(23*PH):PS=INT (D/28):PS=D-(28*PS):IQ=INT (D/33):IQ=D-(33*IQ)
440 FOR V=1TO 3:COLOR V:E=0
450 FOR X=0TO I
460 IF V=2LET Y=SIN ((PH+X)/23*360)*80
470 IF V=3LET Y=SIN ((PS+X)/28*360)*80
480 IF V=1LET Y=SIN ((IQ+X)/33*360)*80
490 W=X*25:F=0
500 IF E=0LET F=9:E=1
510 LLINE (A,B)-(W,Y),F
520 A=W:B=Y:NEXT X:NEXT V
530 GOTO 730
540 IF MA=2GOTO 580
550 IF MA=4OR MA=6OR MA=9OR MA=11GOTO 570
560 I=31:RETURN
570 I=30:RETURN
580 S=INT (JA/4):S=JA-S*4
590 IF S=0GOTO 600ELSE LET I=28:RETURN
600 S=INT (JA/100):S=JA-S*100
610 IF S=0GOTO 620ELSE LET I=29:RETURN
620 S=INT (JA/400):S=JA-S*400
630 IF S=0LET I=29ELSE LET I=28:RETURN
640 IF MA-3<0GOTO 650ELSE LET MA=MA+1:GOTO 660
650 JA=JA-1:MA=13+MA
660 TZ=INT (365.25*JA)+INT (30.6*MA)
670 TZ=TZ-INT (JA/100)+INT (JA/400):TX=TZ
680 IF M-3<0GOTO 690ELSE LET M=M+1:GOTO 700
690 J=J-1:M=13+M
700 TZ=INT (365.25*J)+INT (30.6*M)+T
710 TZ=TZ-INT (J/100)+INT (J/400):TG=TZ
720 RETURN
730 CLS :INPUT "Nächster Monat?    (J/N)  ";Q$
740 IF Q$="N"OR Q$="n"THEN END ELSE LET MO=MO+1:MA=MO:JA=JO:J=JJ:M=MM:CLS :CURSOR 10,2:PRINT MO;" /";JA
750 GOSUB 540:GOSUB 640
760 D=TX-TG:COLOR 0:GLCURSOR (0,-250):SORGN :GOTO 310
770 CLS :END