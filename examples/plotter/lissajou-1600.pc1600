# PC-1600 plotter test -- draws a Lissajous figure on the CE-1600P.

model: PC-1600

# CE-1600P pen-plotter attached.
plotter: CE-1600P

# After reset, a NEW0 is required in PRO mode (PC-1600 starts up in RUN)
keys:
  - key: mode
  - type: NEW0

# A `.bas` listing is tokenized while it loads -- much faster than typing
# it in.
program:
  file: lissajou-1600.bas

# Back to RUN mode, then run it -- the figure plots on the virtual paper.
keys:
  - key: mode
  - type: RUN
  - wait:
