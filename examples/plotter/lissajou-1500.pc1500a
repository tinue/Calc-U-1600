# PC-1500A plotter test -- draws a Lissajous figure on the CE-150.

model: PC-1500A

# CE-150 pen-plotter attached.
plotter: CE-150

# Bring the machine into PRO mode to accept a typed-in program.
keys:
  - key: cl
  - type: NEW0

# A `.bas` listing is tokenized while it loads -- much faster than typing
# it in.
program:
  file: lissajou-1500.bas

# Back to RUN mode, then run it -- the figure plots on the virtual paper.
keys:
  - key: mode
  - type: RUN
  - wait:
