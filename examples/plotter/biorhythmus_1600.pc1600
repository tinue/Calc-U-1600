# PC-1600 plotter program -- plots a biorhythm chart (physical/psychical/
# intellectual cycles) for a given name and birth date on the CE-1600P.
# Program found on https://www.sharp-pc-1600.de

model: PC-1600

# CE-1600P pen-plotter attached.
plotter: ce1600p

# After reset, a NEW0 is required in PRO mode (PC-1600 starts up in RUN)
keys:
  - key: mode
  - type: NEW0

# `format: basic-binary` with a `.bas` path tokenizes the program while
# loading, which is much faster than simulated typing the ascii version.
program:
  path: biorhythmus_1600.bas
  format: basic-binary

# After loading, switch to RUN mode and start the program. Answer the
# input parameters and then wait for finish.
keys:
  - key: mode
  - type: RUN
  - wait: 20
  - type: Martin
  - type: 6
  - type: 8
  - type: 1965
  - wait: 1
  - type: 9
  - type: 2026
  - wait: