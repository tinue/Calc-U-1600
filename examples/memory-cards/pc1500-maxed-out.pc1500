# Loads the fictional 22 KB "maxed-out" card (pc1500-maxed-out.card.yaml,
# same directory) through the universal software-defined module, then
# prints how much of it BASIC sees as free. Companion to
# docs/User-Guide.md's "Custom YAML memory cards" walkthrough.

model: PC-1500
firmware: A04

memory-expansion:
  - modulespecfile: pc1500-maxed-out.card.yaml

keys:
  - key: cl
  - type: PRINT"MEM =";MEM
  - wait: 2
