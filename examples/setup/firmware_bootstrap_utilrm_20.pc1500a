# PC-1500A + the CE-163F module (16 banks: 0-7 RAM, 8-F FLASH).
#
# Performs the full firmware flash from scratch:
#  Start with the generic flasher. It installs a helper into bank 8
#    that allows to load the utilities into bank 8 as well.
#  Then use this flasher to load the utilities.
#  Last use the utilities to format the chip (flash and ram)

format-version: 1
model: PC-1500A

slot-1: CE-163F

keys:
  - key: cl
  - type: NEW0

program:
  file: updaterm.bas

keys:
  - key: mode
  - type: RUN
  - wait: 1
  - type: X=9
  - type: CALL &4100,X
  - type: PRINT"Checksum: (-30440?)";X
  - key: mode

program:
  file: utilrm_20.bas

keys:
  - key: mode
  - type: X=34
  - type: POKE&6808,0
  - type: CALL &150A,X
  - type: PRINT"Checksum (-9066?): ";X
  - type: X=0
  - type: POKE&6808,0
  - type: CALL&2BA,X
  - type: X=0
  - type: CALL &E3,X
