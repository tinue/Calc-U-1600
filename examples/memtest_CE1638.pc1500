# PC-1500 memory test. Loads at the start of general RAM and starts with:
#  X=2 (for 2 passes)
#  CALL &C5,X
# When finished, check X for the test result.

model: PC-1500:A04

memory-expansion:
  - modulespec: CE-1638

keys:
  - key: cl
  - type: NEW&017D
  - key: mode

program:
  path: memtest_CE1638.bin
  format: binary
  address: 0x00C5

keys:
  - type: X=2
  - type: CALL&C5,X
  - type: X
  - wait: 5
