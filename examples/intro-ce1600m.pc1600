# PC-1600 with a CE-1600M (32 KB battery-backed SRAM) in Slot 1, loading
# the same intro program as intro.pc1600 via format: basic-binary.
#
# With the module fitted, NEW0 relocates the BASIC program area out of
# stock internal RAM ($C0C5) into the module window ($80C5). The fast
# loader reads the firmware-maintained ADTBL / S0MTb work-area bytes and
# scatters the tokenised image across the module's 16 KB banks (then
# internal RAM for a larger program), copying it straight into the card's
# backing store. Cf. intro.pc1600 (stock, single internal-RAM window).

model: PC-1600

memory-expansion-1:
  - modulespec: CE-1600M

# Bring the machine into PRO mode and clear the (relocated) program area.
keys:
  - key: mode
  - type: NEW0

# Load the program.
program:
  path: intro.bas
  format: basic-binary

# Back to RUN mode, then start the program.
keys:
  - key: mode
  - type: RUN
