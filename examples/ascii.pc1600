# PC-1600 plotter test -- prints an ASCII/hex character chart on the
# CE-1600P (font size, border colour and font colour are asked for at
# start, answered below as size 2 / border 1 / font 0).
# Program found on https://www.sharp-pc-1600.de

model: PC-1600

# CE-1600P pen-plotter attached.
plotter: ce1600p

# Bring the machine into PRO mode to accept a typed-in program.
keys:
  - key: mode

# `format: basic-binary` with a `.bas` path tokenizes the program while
# loading, which is much faster than simulated typing the ascii version.
program:
  path: ascii.bas
  format: basic-binary

# Back to RUN mode, then run it -- answers the size/colour prompts and
# prints the chart to the virtual paper.
keys:
  - key: mode
  - type: RUN
  - type: 2
  - type: 1
  - type: 0
  - wait: