# PC-1500A + the CE-163F module (16 banks: 0-7 RAM, 8-F FLASH).
#
# Smallest demo of the runtime flash-write protocol, driven entirely from
# direct-mode POKE/PEEK -- no program, no binary, no firmware. Direct mode
# because BASIC's program area starts at &00C5 in the module's bank 0: a
# stored program would switch itself out of the window with its first
# bank select. It shows four things, on byte &200 of FLASH bank 9 (erased
# in the bundled card):
#
#   1. Erased flash reads 0xFF.
#   2. A bare POKE into a FLASH bank does nothing (the bank is locked).
#   3. The JEDEC unlock + byte-program sequence writes the byte.
#   4. A sector erase sets the whole 4 KB sector back to 0xFF.
#
# Bank select: POKE &6808+N  (pin 18 / S5 on the PC-1500A, low nibble = N).
# Here N=9 -> FLASH bank 9.
#
# SST39SF010A command set, low-11-bit decode, so the firmware's real
# &1555/&2AAA addresses are used (not the datasheet's &5555/&2AAA):
#
#   sector erase : &AA->&1555 &55->&2AAA &80->&1555 &AA->&1555 &55->&2AAA
#                  &30->addr-in-sector
#   byte program : &AA->&1555 &55->&2AAA &A0->&1555  byte->addr
#
# Expected on the LCD (each step checks it with expect:):
#   PEEK &200 -> 255   erased
#   PEEK &200 -> 255   after a bare POKE &200,&5A: locked
#   PEEK &200 -> 90    after unlock + program: &5A
#   PEEK &200 -> 255   after the sector erase
# The last step selects RAM bank 0 again.
#
# NOTE: this emulated CE-163F models a simplified bank latch (any S5 write
# samples A0-A3); it does NOT model the real module's separate address-
# strobe latch, so the real firmware's interleaved &6808/&6809 writes are
# not reproduced here -- issue the sequences as pure &1555/&2AAA writes.

model: PC-1500A

slot-1: CE-163F

keys:
  - key: cl
  - type: NEW0
  - type: POKE &6809,0
  - type: PEEK &200
  - expect: 255
  - key: cl
  - type: POKE &200,&5A
  - type: PEEK &200
  - expect: 255
  - key: cl
  - type: POKE &1555,&AA
  - type: POKE &2AAA,&55
  - type: POKE &1555,&A0
  - type: POKE &200,&5A
  - type: PEEK &200
  - expect: 90
  - key: cl
  - type: POKE &1555,&AA
  - type: POKE &2AAA,&55
  - type: POKE &1555,&80
  - type: POKE &1555,&AA
  - type: POKE &2AAA,&55
  - type: POKE &200,&30
  - type: PEEK &200
  - expect: 255
  - key: cl
  - type: POKE &6808,0
