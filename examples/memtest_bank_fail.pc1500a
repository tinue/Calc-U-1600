# PC-1500A + a CE-163-style banked low-16K memory module:
# bank-presence memory validator.
#
# This run asks for 9 banks ("1.9") on a module that physically has 8
# (the CE-1638's bank latch only samples address lines A0-A2 -- bank 8's
# select strobe, a write to &6808, has those three bits all zero, so it
# lands on physical bank 0 same as an explicit bank-0 select would). Bank
# 8 is therefore a phantom: selecting it lands on physical bank 0. The
# mark/check phase catches that -- bank 8's marker write (0x98) overwrites
# bank 0's marker (0x90), so the check of bank 0 fails and the test ends
#
#     Bank mismatch: 0
#
# on the LCD (and X$). Result codes also land in the PEEKable bytes at
# &7C03..&7C08 (ERR_FLAG=4, BANK_AT_ERR=0 here).
#
# No bank-switch firmware is involved -- memtest_bank.bin switches banks
# itself with a bare POKE &6800+N strobe. So, unlike the earlier build,
# this preset loads a single binary and needs no CALL&4100 loader step.
# The whole run takes a couple of minutes of emulated time; the trailing
# `wait` must outlast it for the result to be visible.
#
# X$ = "<passes>[.<banks>]"  (<banks> a single digit 0..9), e.g.
#   X$="3"    -> 3 passes of conventional RAM only, no banks
#   X$="1.8"  -> + 1 pass of each real bank 0..7, then mark/check -> "Test ok"
#   X$="1.9"  -> as here: exposes the phantom 9th bank
# See memtest_bank.asm's header for the full calling convention.

model: PC-1500A
firmware: A04

memory-expansion:
  - modulespec: CE-1638

keys:
  - key: cl
  - type: NEW0
  - key: mode

program:
  path: memtest_bank.bin
  format: binary
  address: 0x7C01

keys:
  - type: X$="1.9"
  - type: CALL&7C01,X$
  - wait: 200
  - type: X$
  - wait: 5
