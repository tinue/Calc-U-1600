# PC-1500A + a CE-163-style banked low-16K memory module:
#
# Runs a memtest over all banks, 2 passes.

format-version: 1
model: PC-1500A

slot-1: CE-1638

keys:
  - key: cl
  - type: NEW0
  - key: mode

program:
  file: memtest_bank.bin
  address: 0x7C01

keys:
  - type: X$="2.8"
  - type: CALL&7C01,X$
  - wait: 200
  - type: X$
  - wait: 5
