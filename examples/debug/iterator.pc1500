# Debug the Up/Down key issue
model: PC-1500A
firmware: A04

keys:
  - key: cl
  - type: NEW0

program:
  format: basic-text
  text: |
    10 WAIT 10
    20 FOR I = 1 TO 100
    30 PRINT I
    40 NEXT I

keys:
  - key: mode
  - type: RUN
  - wait: 2
  - key: break
  - key: cl
  - key: mode
  - key: up
