# PC-1600 plotter test -- draws a Lissajous figure on the CE-1600P.

model: PC-1500A

# Start with the CE-1600P pen-plotter connected (attached before the cold
# boot, so the ROM detects it). The PC-1600 also takes a CE-150, so this
# names the peripheral rather than a plain on/off.
plotter: ce150

# Bring the machine into PRO mode to accept a typed-in program.
keys:
  - key: cl
  - type: NEW0

# `format: basic-binary` with a `.bas` path tokenizes the listing in
# process on load (via the vendored libsharpdx) -- no separate .bbin step.
program:
  path: lissajou-1500.bas
  format: basic-binary

# Back to RUN mode, then run it -- the figure plots on the virtual paper.
keys:
  - key: mode
  - type: RUN
  - wait: