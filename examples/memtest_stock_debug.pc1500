# Clean start for debugging memtest.asm (stock build, ENTRY = &40C5) in
# VS Code: a stock PC-1500 with &40C5-&417C reserved, in RUN mode. The
# debugger's Build & Load then loads the program and types its CALL.
# Unlike memtest_stock.pc1500, this doesn't load or run the program itself.

model: PC-1500:A04

keys:
  - key: cl
  - type: NEW&417D
  - key: mode
