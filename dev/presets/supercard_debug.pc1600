# PC-1600 debug set for the superRAM card in slot 2: formats and splits it,
# then shows the free memory and the RAM disk's size.
format-version: 1
model: PC-1600

slot-2: superRAM

# init the card
keys:
  - key: mode
  - type: NEW0
  - type: INIT"S2:","F"
  - type: INIT"S2:","M"
  - type: X=MEM
  - type: Y=DSKF"S2:"
  - key: shift
  - key: cl
  - type: PRINT"Memory:";X;" Disk:";Y
