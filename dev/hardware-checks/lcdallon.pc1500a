# Lights every dot-matrix pixel and every status indicator on the
# PC-1500A's LCD at once, for checking the display's indicator and
# dot-matrix sizing against real hardware. See lcdallon_1500a.asm's own
# header for the display-RAM layout and the BREAK poll.
#
# The last `keys:` block types `CALL &7C01,X` -- safe even though the
# routine loops until BREAK (ON) is pressed and never returns: a `type:`
# step returns after its ENTER, so the preset finishes with the CPU parked
# in the routine's wait loop, the display fully lit.
#
# After this preset loads, in the running app: everything is already
# lit -- just press ON (BREAK) when done looking, to return to the
# READY prompt.
model: PC-1500A

keys:
  - key: cl
  - type: NEW0
  - key: mode

program:
  file: lcdallon_1500a.bin
  address: 0x7C01

keys:
  - type: CALL&7C01,X
